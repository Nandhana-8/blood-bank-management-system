SECRET_KEY=change_this_to_a_random_secret_key

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=blood_bank_db

PORT=5000
DEBUG=True
